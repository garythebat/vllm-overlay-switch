#!/usr/bin/env bash
# After each commit: start a line in the private log (outside the repository) for the context that must not go in
# the commit message: why, who asked, the session. Silent; does nothing in a clone without private/notes/log.md.
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0
log=private/notes/log.md
[ -f "$log" ] || exit 0
printf -- '- %s %s %s | why: | asked: | session:\n' "$(git log -1 --format=%h)" \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git log -1 --format=%s)" >> "$log" 2>/dev/null
exit 0
