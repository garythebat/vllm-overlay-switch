#!/usr/bin/env bash
# Commit messages are technical only. Refuses: a subject outside "<area>[(<group>)]: <text>" or over 72 characters,
# link trailers ("Key: https://...") unless allowed with git config --add privacy.allowTrailer <Key>, attribution
# lines (Co-authored-by:, or a line that starts "Generated with" or "Generated by"), anything the privacy scan finds
# (deny-list, addresses, en or em dashes), and a local time zone (commit with TZ=UTC0).
# Only the repository owner decides to allow a trailer; to get past a refused trailer, move the link to
# private/notes/log.md, never add an allowTrailer.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
msg="$1"
fail() { echo "commit-msg: $1"; echo "commit-msg: personal context goes in private/notes/log.md"; exit 1; }
subject=$(grep -v '^#' "$msg" | sed -n '/[^[:space:]]/{p;q;}')
case "$subject" in
  "Merge "*|"Revert \""*) ;;
  *)
    printf '%s\n' "$subject" | grep -Eq '^(mod|engine|recipes|tests|docs|tools|licence)(\([a-z0-9-]+\))?: [^[:space:]]' \
      || fail "the subject must look like '<area>[(<group>)]: <imperative>' (areas: mod engine recipes tests docs tools licence)"
    [ "${#subject}" -le 72 ] || fail "the subject is longer than 72 characters"
    ;;
esac
allowed=$(git config --get-all privacy.allowTrailer 2>/dev/null || true)
while IFS= read -r line; do
  key=${line%%:*}
  printf '%s\n' "$allowed" | grep -qxF "$key" || fail "a link trailer ($key) is not allowed in this repository"
done < <(grep -v '^#' "$msg" | grep -E '^[A-Za-z-]+: https?://' || true)
# vendor-neutral on purpose: no tool or vendor name needs to appear here
grep -v '^#' "$msg" | grep -Eiq '^(co-authored-by:|[^[:alnum:]]*generated (with|by)[[:space:]])' \
  && fail "attribution lines are not used in this repository"
if [ -f tools/check_private.py ]; then
  python3 tools/check_private.py --message "$msg" || fail "the message has a privacy hit (see above)"
fi
[ "$(date +%z)" = "+0000" ] || fail "commit with TZ=UTC0 (setup-clone.sh defines \`git ci\`)"
exit 0
